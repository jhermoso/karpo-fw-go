{
    "id": "supplier",
    "name": "Proveedor",
    "namePlural": "Proveedores",
    "description": "Perfiles de compra de los proveedores de las empresas de Karpo Go",
    "icon": "briefcase",
    "color": "#16a085",
    "apiEndpoint": "/suppliers",
    "editable": true,
    "editType": "direct",
    "primaryKey": "id",
    "displayField": "supplier",
    "dataSource": {
        "type": "single",
        "paginationStrategy": "server",
        "serverFiltering": {
            "enabled": true,
            "fieldMapping": {},
            "clientOnlyFields": [],
            "companyFilterField": "company"
        }
    },
    "form": {
        "modalSize": "md",
        "createTitle": "Nuevo proveedor",
        "editTitle": "Editar proveedor",
        "saveButtonText": "Guardar",
        "cancelButtonText": "Cancelar",
        "sections": [
            {
                "id": "main",
                "title": "Datos de compra",
                "icon": "briefcase",
                "collapsible": false,
                "columns": 2,
                "fields": [
                    {
                        "field": "supplier",
                        "label": "Proveedor (party)",
                        "type": "text",
                        "required": true,
                        "width": 6,
                        "hint": "Identidad del proveedor como party; no cambia después del alta."
                    },
                    {
                        "field": "category",
                        "label": "Categoría de gasto",
                        "type": "select",
                        "width": 6,
                        "options": [
                            {
                                "value": "goods",
                                "label": "Mercaderías (600)"
                            },
                            {
                                "value": "rent",
                                "label": "Arrendamientos (621)"
                            },
                            {
                                "value": "repairs",
                                "label": "Reparaciones (622)"
                            },
                            {
                                "value": "professional-services",
                                "label": "Servicios profesionales (623)"
                            },
                            {
                                "value": "transport",
                                "label": "Transportes (624)"
                            },
                            {
                                "value": "insurance",
                                "label": "Seguros (625)"
                            },
                            {
                                "value": "advertising",
                                "label": "Publicidad (627)"
                            },
                            {
                                "value": "supplies",
                                "label": "Suministros (628)"
                            },
                            {
                                "value": "other-services",
                                "label": "Otros servicios (629)"
                            },
                            {
                                "value": "fixed-asset",
                                "label": "Inmovilizado (21x)"
                            }
                        ]
                    },
                    {
                        "field": "withholdingRate",
                        "label": "Retención (%)",
                        "type": "text",
                        "width": 4,
                        "hint": "De 0 a 50, con dos decimales."
                    },
                    {
                        "field": "paymentDays",
                        "label": "Días de pago",
                        "type": "number",
                        "width": 4,
                        "hint": "De 0 a 365."
                    },
                    {
                        "field": "iban",
                        "label": "IBAN",
                        "type": "text",
                        "maxLength": 34,
                        "width": 4
                    }
                ]
            }
        ]
    },
    "grid": {
        "columns": [
            {
                "field": "supplier",
                "header": "Proveedor",
                "type": "text",
                "width": 280
            },
            {
                "field": "category",
                "header": "Categoría",
                "type": "text",
                "width": 160,
                "filterable": true
            },
            {
                "field": "withholdingRate",
                "header": "Retención",
                "type": "text",
                "width": 100
            },
            {
                "field": "paymentDays",
                "header": "Días de pago",
                "type": "number",
                "width": 110,
                "sortable": true
            },
            {
                "field": "blocked",
                "header": "Estado",
                "type": "badge",
                "width": 120,
                "badgeMap": {
                    "false": {
                        "label": "Activo",
                        "color": "green"
                    },
                    "true": {
                        "label": "Bloqueado",
                        "color": "gray"
                    }
                }
            }
        ],
        "defaultSort": {
            "field": "paymentDays",
            "direction": "asc"
        },
        "pageSize": 25,
        "pageSizeOptions": [
            10,
            25,
            50,
            100
        ],
        "selectable": true,
        "selectionMode": "multiple",
        "rowActions": [
            {
                "action": "view",
                "label": "Ver detalle",
                "icon": "view",
                "color": "primary"
            },
            {
                "action": "edit",
                "label": "Editar",
                "icon": "edit",
                "color": "warning"
            },
            {
                "action": "delete",
                "label": "Bloquear",
                "icon": "delete",
                "color": "danger"
            }
        ]
    },
    "filters": [
        {
            "field": "isActive",
            "serverField": "isActive",
            "label": "Sólo activos",
            "type": "checkbox",
            "width": 2
        }
    ],
    "detail": {
        "showHistory": false,
        "showRelations": false,
        "showTags": false,
        "sections": [
            {
                "id": "main",
                "title": "Proveedor",
                "icon": "briefcase",
                "collapsible": true,
                "collapsed": false,
                "columns": 2,
                "fields": [
                    {
                        "field": "supplier",
                        "label": "Proveedor (party)",
                        "type": "text",
                        "editable": false
                    },
                    {
                        "field": "category",
                        "label": "Categoría de gasto",
                        "type": "text",
                        "editable": true
                    },
                    {
                        "field": "withholdingRate",
                        "label": "Retención (%)",
                        "type": "text",
                        "editable": true
                    },
                    {
                        "field": "paymentDays",
                        "label": "Días de pago",
                        "type": "number",
                        "editable": true
                    },
                    {
                        "field": "iban",
                        "label": "IBAN",
                        "type": "text",
                        "editable": true,
                        "maxLength": 34
                    },
                    {
                        "field": "blocked",
                        "label": "Bloqueado",
                        "type": "checkbox",
                        "editable": true,
                        "hint": "A un proveedor bloqueado no se le registran facturas nuevas."
                    },
                    {
                        "field": "blockReason",
                        "label": "Motivo del bloqueo",
                        "type": "text",
                        "editable": true,
                        "maxLength": 200
                    }
                ]
            }
        ]
    },
    "availableViews": [
        "grid",
        "detail"
    ],
    "defaultView": "grid",
    "searchable": false,
    "searchFields": [],
    "metadata": {
        "version": "1.0.0",
        "author": "Karpo Go",
        "lastModified": "2026-11-14",
        "tags": [
            "purchases",
            "karpo-go"
        ]
    }
}

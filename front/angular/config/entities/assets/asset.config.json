                    },
                    {
                        "field": "class",
                        "label": "Clase",
                        "type": "text",
                        "editable": false
                    },
                    {
                        "field": "serial",
                        "label": "Número de serie",
                        "type": "text",
                        "editable": true,
                        "maxLength": 60
                    },
                    {
                        "field": "location",
                        "label": "Ubicación",
                        "type": "text",
                        "editable": true
                    },
                    {
                        "field": "acquired",
                        "label": "Adquisición",
                        "type": "date",
                        "editable": false
                    },
                    {
                        "field": "inService",
                        "label": "Puesta en servicio",

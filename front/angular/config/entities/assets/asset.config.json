{
    "id": "asset",
    "name": "Activo",
    "namePlural": "Activos",
    "description": "Registro de inmovilizado de las empresas de Karpo Go",
    "icon": "package",
    "color": "#8e44ad",
    "apiEndpoint": "/assets",
    "editable": true,
    "editType": "direct",
    "primaryKey": "id",
    "displayField": "name",
    "dataSource": {
        "type": "single",
        "paginationStrategy": "server",
        "serverFiltering": {
            "enabled": true,
            "fieldMapping": {},
            "clientOnlyFields": [],
            "companyFilterField": "company"
        }
    },
    "form": {
        "modalSize": "md",
        "createTitle": "Nuevo activo",
        "editTitle": "Editar activo",
        "saveButtonText": "Guardar",
        "cancelButtonText": "Cancelar",
        "sections": [
            {
                "id": "main",
                "title": "Datos del activo",
                "icon": "package",
                "collapsible": false,
                "columns": 2,
                "fields": [
                    {
                        "field": "code",
                        "label": "Código",
                        "type": "text",
                        "required": true,
                        "maxLength": 20,
                        "width": 4,
                        "hint": "No cambia después del alta."
                    },
                    {
                        "field": "name",
                        "label": "Nombre",
                        "type": "text",
                        "required": true,
                        "maxLength": 120,
                        "width": 8
                    },
                    {
                        "field": "class",
                        "label": "Clase",
                        "type": "select",
                        "required": true,
                        "width": 4,
                        "options": [
                            {
                                "value": "land",
                                "label": "Terrenos"
                            },
                            {
                                "value": "buildings",
                                "label": "Construcciones"
                            },
                            {
                                "value": "machinery",
                                "label": "Maquinaria"
                            },
                            {
                                "value": "tooling",
                                "label": "Utillaje"
                            },
                            {
                                "value": "furniture",
                                "label": "Mobiliario"
                            },
                            {
                                "value": "computers",
                                "label": "Equipos informáticos"
                            },
                            {
                                "value": "vehicles",
                                "label": "Vehículos"
                            },
                            {
                                "value": "software",
                                "label": "Aplicaciones informáticas"
                            },
                            {
                                "value": "other",
                                "label": "Otro"
                            }
                        ],
                        "hint": "No cambia después del alta."
                    },
                    {
                        "field": "serial",
                        "label": "Número de serie",
                        "type": "text",
                        "maxLength": 60,
                        "width": 4
                    },
                    {
                        "field": "location",
                        "label": "Ubicación",
                        "type": "text",
                        "width": 4,
                        "hint": "Identidad de la instalación donde está."
                    },
                    {
                        "field": "acquired",
                        "label": "Adquisición",
                        "type": "date",
                        "required": true,
                        "width": 4,
                        "hint": "No cambia después del alta."
                    },
                    {
                        "field": "inService",
                        "label": "Puesta en servicio",
                        "type": "date",
                        "width": 4,
                        "hint": "Por omisión, la de adquisición; no cambia después."
                    },
                    {
                        "field": "cost",
                        "label": "Coste",
                        "type": "number",
                        "required": true,
                        "width": 4,
                        "hint": "No cambia después del alta."
                    },
                    {
                        "field": "residual",
                        "label": "Valor residual",
                        "type": "number",
                        "width": 4,
                        "hint": "No cambia después del alta."
                    },
                    {
                        "field": "lifeMonths",
                        "label": "Vida útil (meses)",
                        "type": "number",
                        "width": 4,
                        "hint": "Cero para los terrenos; no cambia después del alta."
                    }
                ]
            }
        ]
    },
    "grid": {
        "columns": [
            {
                "field": "code",
                "header": "Código",
                "type": "text",
                "width": 110,
                "sortable": true,
                "filterable": true
            },
            {
                "field": "name",
                "header": "Nombre",
                "type": "text",
                "width": 240,
                "sortable": true,
                "filterable": true
            },
            {
                "field": "class",
                "header": "Clase",
                "type": "text",
                "width": 130
            },
            {
                "field": "cost",
                "header": "Coste",
                "type": "number",
                "width": 120
            },
            {
                "field": "netBookValue",
                "header": "Valor neto",
                "type": "number",
                "width": 120
            },
            {
                "field": "status",
                "header": "Estado",
                "type": "badge",
                "width": 120,
                "badgeMap": {
                    "in-service": {
                        "label": "En servicio",
                        "color": "green"
                    },
                    "depreciated": {
                        "label": "Amortizado",
                        "color": "blue"
                    },
                    "disposed": {
                        "label": "De baja",
                        "color": "gray"
                    }
                }
            }
        ],
        "defaultSort": {
            "field": "code",
            "direction": "asc"
        },
        "pageSize": 25,
        "pageSizeOptions": [
            10,
            25,
            50,
            100
        ],
        "selectable": true,
        "selectionMode": "multiple",
        "rowActions": [
            {
                "action": "view",
                "label": "Ver detalle",
                "icon": "view",
                "color": "primary"
            },
            {
                "action": "edit",
                "label": "Editar",
                "icon": "edit",
                "color": "warning"
            }
        ]
    },
    "filters": [
        {
            "field": "_search",
            "serverField": "search",
            "label": "Buscar",
            "type": "text",
            "placeholder": "Nombre…",
            "icon": "search",
            "width": 3,
            "searchFields": [
                "name"
            ]
        }
    ],
    "detail": {
        "showHistory": false,

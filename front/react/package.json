{
  "name": "@karpo/react",
  "version": "0.1.0",
  "private": true,
  "description": "Front React de Karpo Go: ERP/CRM dirigido por configuración, con cuadrículas editables, organigramas y mapas por niveles.",
  "license": "GPL-2.0-only",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15",
      "onFail": "warn"
    }
  },
  "sideEffects": [
    "**/*.css",
    "./src/ui/index.ts",
    "./src/fields/index.ts"
  ],
  "main": "./dist/karpo-react.js",
  "module": "./dist/karpo-react.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/karpo-react.js"
    },
    "./karpo.css": "./dist/karpo.css",
    "./map.css": "./dist/karpo-map.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --mode demo",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.map-css.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --mode demo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run --project unit --project components",
    "test:contract": "vitest run --project contract",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "coverage": "vitest run --project unit --project components --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:contract && npm run licencias -- --check && npm run icons:gen -- --check && npm run i18n:demo -- --check && npm run build && npm run presupuesto && npm run pack:check",
    "licencias": "node scripts/licencias.mjs",
    "themes:sync": "node scripts/sync-themes.mjs",
    "geo:build": "node scripts/gen-geo.mjs",
    "tiles:build": "node scripts/build-pmtiles.mjs",
    "seed:karpo": "node scripts/seed-karpo.mjs",
    "karpo:local": "node scripts/karpo-local.mjs",
    "karpo:stop": "node scripts/karpo-stop.mjs",
    "capturas": "node scripts/capturas.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepublishOnly": "node scripts/no-publish.mjs",
    "icons:gen": "node scripts/gen-icons.mjs",
    "i18n:demo": "node scripts/gen-demo-i18n.mjs",
    "presupuesto": "node scripts/presupuesto.mjs"
  },
  "peerDependencies": {
    "react": ">=19.2.7",
    "react-dom": ">=19.2.7"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.4",
    "@floating-ui/react": "0.27.20",
    "@hookform/resolvers": "7.0.9",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.28",
    "@xyflow/react": "13.0.3",
    "cmdk": "1.1.1",
    "driver.js": "1.14.0",
    "fuse.js": "7.5.0",
    "i18next": "27.2.9",
    "immer": "11.2.13",
    "maplibre-gl": "6.19.0",
    "pmtiles": "4.5.0",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-resizable-panels": "4.24.3",
    "react-router": "8.5.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.8",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
